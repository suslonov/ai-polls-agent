# Copy to .env, fill in, then: chmod 600 .env
# Credentials are read directly from this file via dotenv_values() —
# never from process environment variables.

# LLMs
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# AWS (an `export ` prefix is tolerated)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Optional, only for temporary STS credentials
AWS_SESSION_TOKEN=

# Kvasir identity used in the synthetic API Gateway authorizer event.
# This must be a Cognito/user "sub" that has author/admin access to the target courses.
KVASIR_USER_SUB=
# Human-readable owner of the sub above (informational only)
KVASIR_USER=

# Target Kvasir course per generated language
KVASIR_COURSE_EN=
KVASIR_COURSE_RU=

# Template echo component id (same template is used for both languages)
KVASIR_TEMPLATE=

# Telegram publishing
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_EN=
TELEGRAM_CHANNEL_RU=
